{
  "name": "trueedge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @trueedge/web dev",
    "build": "pnpm --filter @trueedge/web build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "pnpm -r typecheck && tsc -p tsconfig.e2e.json --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "e2e": "playwright test",
    "simulate": "pnpm --filter @trueedge/cli simulate",
    "desktop:dev": "pnpm --filter @trueedge/desktop run dev",
    "desktop:pack": "pnpm --filter @trueedge/desktop run pack",
    "desktop:dist": "pnpm --filter @trueedge/desktop run dist",
    "desktop:dist:mac": "pnpm --filter @trueedge/desktop run dist:mac"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.6",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.0",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.2",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
